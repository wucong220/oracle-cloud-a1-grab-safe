-User=opc
-# %h 会被 systemd 展开成上面的 User 的 home 目录
+Type=oneshot
 WorkingDirectory=%h/a1grab
-ExecStart=%h/a1grab/grab.sh
-
-# 抢到之后 grab.sh 会自己 exit 0，重启后因 SUCCESS 标记存在会立即退出，
