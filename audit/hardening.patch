+import base64
+import configparser
+import contextlib
+import datetime as dt
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import re
+import shlex
+import subprocess
+import sys
+import tempfile
+import time
+import uuid
+
+UTC = dt.timezone.utc
+REGION = "ap-tokyo-1"
+SHAPE = "VM.Standard.A1.Flex"
+CLI_VERSION = "3.95.1"
+POLICY_DATE = "2026-10-22"
+POLICY_URL = "https://docs.oracle.com/en-us/iaas/Content/FreeTier/freetier_topic-Always_Free_Resources.htm"
